<?xml version="1.0" ?>
<sdf version="1.6">

  <world name="box_touch_world">

    <!-- SUN -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.5 -1</direction>
    </light>


    <!-- GROUND -->
    <model name="ground">
      <static>true</static>

      <link name="link">

        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>

          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- TARGET BOX -->
    <model name="target_box">
      <static>true</static>

      <!-- Box COM -->
      <!-- x = 1.5 m, y = 0.8 m, z = 0.05 m -->
      <pose>1.5 0.8 0.05 0 0 0</pose>

      <link name="box_link">

        <!-- COLLISION -->
        <collision name="collision">
          <geometry>
            <box>
              <size>0.50 0.20 0.10</size>
            </box>
          </geometry>
        </collision>

        <!-- VISUAL -->
        <visual name="visual">

          <geometry>
            <box>
              <size>0.50 0.20 0.10</size>
            </box>
          </geometry>

          <!-- GREEN -->
          <material>
            <ambient>0 0.8 0 1</ambient>
            <diffuse>0 1 0 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>

        </visual>

      </link>
    </model>

  </world>

</sdf>